# ==============================================================================
# PROJET PANU — GESTIONNAIRE DE CLÉS API UNIVERSEL (MODÈLE .ENV)
# Configurez vos clés via le panneau Secrets dans AI Studio ou Supabase Vault
# ==============================================================================

# 1. SUPABASE (Base de données, Auth, Realtime, Edge Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# 2. HUB MULTI-IA (Google Gemini, Anthropic Claude, Replicate, Fal.ai)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_CLAUDE_API_KEY
REPLICATE_API_KEY=YOUR_REPLICATE_API_KEY
FAL_KEY=YOUR_FAL_AI_API_KEY
REACT_APP_FAL_KEY=YOUR_FAL_AI_API_KEY

# 3. STREAMING TEMPS RÉEL WEBRTC (LiveKit / Agora)
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# 4. ALERTES EMAIL RÉELLES GMAIL FONDATEUR (Resend / Webhook SMTP)
FOUNDER_EMAIL=emmanuelmatia150@gmail.com
RESEND_API_KEY=YOUR_RESEND_API_KEY
FOUNDER_ALERT_WEBHOOK_URL=YOUR_OPTIONAL_WEBHOOK_URL

